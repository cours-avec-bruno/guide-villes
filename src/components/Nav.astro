---
// La navigation : fixe en haut. Sur téléphone, les liens se déroulent sous le bouton « Menu ».
// « ici » : les ancres présentes sur la page (les autres liens mènent à l'accueil).
import { url } from "../base";
import { MARQUE } from "../marque";
import Fleche from "./Fleche.astro";
import Logo from "./Logo.astro";

interface Props { ici?: string[] }
const { ici = [] } = Astro.props;
const lien = (ancre: string) => (ici.includes(ancre) ? `#${ancre}` : url(`/#${ancre}`));
const LIENS = [
  { ancre: "villes", nom: "Les villes" },
  { ancre: "comment", nom: "Comment ça marche" },
  { ancre: "formules", nom: "Tarifs" },
  { ancre: "questions", nom: "Questions" },
];
---

<a class="evitement" href="#contenu">Aller au contenu</a>
<header class="nav" data-nav>
  <div class="nav__barre">
    <a class="nav__logo" href={url("/")} aria-label={`${MARQUE}, accueil`}><Logo /></a>
    <nav class="nav__liens" aria-label="Navigation principale">
      {LIENS.map((l) => <a href={lien(l.ancre)}>{l.nom}</a>)}
    </nav>
    <div class="nav__actions">
      <a class="btn btn--contour btn--petit nav__code" href={url("/lyon/")}>J'ai un code</a>
      <a class="btn btn--plein btn--petit nav__guide" href={url("/guides/lyon/")}>Le guide de Lyon<Fleche /></a>
      <button type="button" class="nav__menu" aria-expanded="false" aria-controls="menu" data-menu>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Menu</span>
      </button>
    </div>
  </div>
  <div class="menu" id="menu" hidden>
    <nav aria-label="Menu">
      {LIENS.map((l) => <a class="menu__lien" href={lien(l.ancre)}>{l.nom}<Fleche /></a>)}
    </nav>
    <div class="menu__actions">
      <a class="btn btn--plein btn--bloc" href={url("/guides/lyon/")}>Le guide de Lyon<Fleche /></a>
      <a class="btn btn--contour btn--bloc" href={url("/lyon/")}>J'ai un code</a>
    </div>
  </div>
</header>
