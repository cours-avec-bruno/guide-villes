---
// Un téléphone avec une capture de l'appli dedans.
import { url } from "../base";
interface Props { ecran: string; alt: string; class?: string; eager?: boolean }
const { ecran, alt, class: classe, eager } = Astro.props;
---

<div class:list={["tel", classe]}>
  <img src={url(`/plaques/ecran-${ecran}.webp`)} alt={alt} width="780" height="1688" loading={eager ? "eager" : "lazy"} decoding="async" />
</div>
