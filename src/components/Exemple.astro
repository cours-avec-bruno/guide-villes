---
// Un arrêt du guide, en vrai : la vraie vidéo, le texte et le conseil sur place.
import { url } from "../base";
import { VIDEOS, etape } from "../app/donnees";
import Fleche from "./Fleche.astro";

const e = etape("guignol");
const v = e.videos[0];
const duree = Math.round((VIDEOS[v].a - VIDEOS[v].de) / 30);
---

<section class="exemple" id="exemple" aria-labelledby="t-exemple">
  <div class="enveloppe exemple__grille">
    <div class="exemple__lecteur entre">
      <button type="button" class="lecteur-ex" data-video={url(`/videos/lyon/${v}.mp4`)} aria-label={`Lire la vidéo de l'arrêt « ${e.nom} », ${duree} secondes, avec le son`}>
        <img src={url(`/videos/lyon/${v}.jpg`)} alt="" width="540" height="960" loading="lazy" decoding="async" />
        <span class="lecteur-ex__rond" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M8 5.5v13l11-6.5-11-6.5z"></path></svg></span>
        <span class="lecteur-ex__texte" aria-hidden="true">Voir la vidéo · {duree} s</span>
      </button>
    </div>
    <div class="exemple__texte entre">
      <p class="etiquette">Un arrêt du guide · {e.quartier}</p>
      <h2 id="t-exemple">{e.nom}</h2>
      <p class="exemple__lieu">{e.lieu}</p>
      <p class="exemple__fait">{e.fait}</p>
      <p class="exemple__conseil"><strong>Sur place.</strong> {e.conseil}</p>
      <a class="btn btn--plein" href="#formules">Commencer gratuitement<Fleche sens="bas" /></a>
    </div>
  </div>
</section>
