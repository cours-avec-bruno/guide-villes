---
// Les pages de vente (l'accueil et les pages des guides) : la navigation, le contenu, le pied de page.
// Pas de chorégraphie : les blocs apparaissent doucement en entrant à l'écran, et c'est tout.
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Pied from "../components/Pied.astro";
import Fleche from "../components/Fleche.astro";

interface Props { titre: string; description: string; image?: string; ici?: string[]; barre?: boolean }
const { titre, description, image, ici, barre = true } = Astro.props;
---

<Base titre={titre} description={description} image={image}>
  <script is:inline slot="tete">document.documentElement.classList.add("js");</script>
  <slot name="tete" slot="tete" />
  <Nav ici={ici} />
  <main id="contenu">
    <slot />
  </main>
  <Pied />
  {barre && (
    <div class="barre-achat" data-barre aria-hidden="true">
      <p><strong>Guide de Lyon</strong><span>Gratuit avec un code, ou complet</span></p>
      <a class="btn btn--plein btn--petit" href="#formules" tabindex="-1">Voir les tarifs<Fleche sens="bas" /></a>
    </div>
  )}
  <script>
    import "../scripts/site.ts";
  </script>
</Base>

<style is:global>
  @import "../styles/site.css";
</style>
