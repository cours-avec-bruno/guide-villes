---
import "@fontsource/bebas-neue/400.css";
import "@fontsource-variable/space-grotesk";
import "../styles/base.css";
import { url } from "../base";

interface Props {
  titre: string;
  description: string;
  type?: string;
  image?: string;
}
const { titre, description, type = "software", image = "/partage.jpg" } = Astro.props;
const imagePartage = new URL(url(image), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="fr" data-type={type}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="page-type" content={type} />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#f3eddd" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imagePartage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta property="og:locale" content="fr_FR" />
    <slot name="tete" />
  </head>
  <body>
    <slot />
  </body>
</html>
