---
// La page d'achat du guide d'une ville. Lyon : le guide, ses deux formules, ses lieux. Les autres villes : « en préparation ».
import Site from "../../layouts/Site.astro";
import Villes from "../../components/Villes.astro";
import Etapes from "../../components/Etapes.astro";
import Exemple from "../../components/Exemple.astro";
import Formules from "../../components/Formules.astro";
import Faq from "../../components/Faq.astro";
import Fleche from "../../components/Fleche.astro";
import Telephone from "../../components/Telephone.astro";
import { url } from "../../base";
import { INSTAGRAM, MARQUE, PRIX_COMPLET, PRIX_COMPLET_NOMBRE } from "../../marque";
import { VILLES, type Ville } from "../../data/villes";
import { ADRESSES, ETAPES, NB_VIDEOS, VISITES } from "../../app/donnees";

export function getStaticPaths() {
  return VILLES.map((v) => ({ params: { ville: v.id }, props: { v } }));
}
const { v } = Astro.props as { v: Ville };
const nE = ETAPES.length, nA = ADRESSES.length;
const gratuits = new Set(VISITES[0].etapes);
const donnees = v.pret && {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Le guide de ${v.nom}`,
  description: `Guide de visite de ${v.nom} à suivre sur son téléphone : ${nE} lieux, ${NB_VIDEOS} vidéos, ${nA} bonnes adresses.`,
  image: new URL(url(`/cartes/${v.id}.webp`), Astro.site).href,
  brand: { "@type": "Brand", name: MARQUE },
  offers: [
    { "@type": "Offer", name: `Guide gratuit : Les 5 secrets de ${v.nom}`, price: "0", priceCurrency: "EUR" },
    { "@type": "Offer", name: `Guide complet de ${v.nom}`, price: PRIX_COMPLET_NOMBRE, priceCurrency: "EUR" },
  ],
};
---

{v.pret ? (
  <Site
    titre={`Guide de ${v.nom} : ${nE} lieux secrets à visiter en vidéo | ${MARQUE}`}
    description={`Visite ${v.nom} avec un guide sur ton téléphone : ${nE} lieux insolites, une vidéo à chaque arrêt, la carte, les horaires et ${nA} bonnes adresses. Gratuit avec un code, ou ${PRIX_COMPLET} le guide complet.`}
    ici={["comment", "formules", "questions"]}
  >
    <script is:inline slot="tete" type="application/ld+json" set:html={JSON.stringify(donnees)} />

    <section class="hero hero--guide" aria-labelledby="t-hero">
      <div class="enveloppe hero__grille">
        <div class="hero__texte">
          <p class="fil-ariane"><a href={url("/")}>Accueil</a> <span aria-hidden="true">/</span> Les guides <span aria-hidden="true">/</span> {v.nom}</p>
          <p class="etiquette">Disponible</p>
          <h1 id="t-hero">Le guide de {v.nom}</h1>
          <p class="hero__chapo">{nE} lieux à voir sur place, {NB_VIDEOS} vidéos, {nA} bonnes adresses. Tu marches, la carte te guide ; à chaque arrêt, la vidéo te raconte le lieu.</p>
          <div class="hero__actions">
            <a class="btn btn--plein btn--grand" href="#formules">Voir les deux formules<Fleche sens="bas" /></a>
            <a class="btn btn--contour btn--grand" href={url(`/${v.id}/`)}>J'ai un code</a>
          </div>
          <ul class="hero__points">
            <li>Gratuit : « Les 5 secrets », avec un code reçu par e-mail</li>
            <li>Complet : tout {v.nom} pour {PRIX_COMPLET}, une seule fois</li>
            <li>Sans appli à installer, sans compte</li>
          </ul>
        </div>
        <div class="hero__visuel" aria-hidden="true">
          <img class="hero__carte" src={url(`/cartes/${v.id}.webp`)} alt="" width="600" height="792" fetchpriority="high" />
          <Telephone ecran="parcours" alt="" class="hero__tel" eager />
          <p class="hero__bulle"><strong>1 h 30</strong> à la journée</p>
        </div>
      </div>
    </section>

    <Formules />

    <section class="lieux" id="lieux" aria-labelledby="t-lieux">
      <div class="enveloppe">
        <h2 id="t-lieux" class="titre-section entre">Les {nE} lieux du guide</h2>
        <p class="section-sous entre">Les lieux marqués « Gratuit » forment la balade des 5 secrets. Le guide complet les ouvre tous.</p>
        <ol class="lieux__grille">
          {ETAPES.map((e) => (
            <li class="lieu entre">
              <img src={url(`/videos/lyon/${e.videos[0]}.jpg`)} alt="" width="540" height="960" loading="lazy" decoding="async" />
              {gratuits.has(e.id) && <span class="lieu__tag">Gratuit</span>}
              <span class="lieu__texte"><strong>{e.nom}</strong><span>{e.quartier}</span></span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Etapes />

    <Exemple />

    <Faq />

    <Villes titre="Les prochaines villes" sous="Fais glisser pour les voir. Chaque guide sort après sa série de vidéos." sauf={v.id} />
  </Site>
) : (
  <Site
    titre={`Guide de ${v.nom} : bientôt disponible | ${MARQUE}`}
    description={`Le guide de visite de ${v.nom} en vidéo est en préparation. En attendant, le guide de Lyon est disponible.`}
    barre={false}
  >
    <section class="hero hero--guide hero--bientot" aria-labelledby="t-hero">
      <div class="enveloppe hero__grille">
        <div class="hero__texte">
          <p class="fil-ariane"><a href={url("/")}>Accueil</a> <span aria-hidden="true">/</span> Les guides <span aria-hidden="true">/</span> {v.nom}</p>
          <p class="etiquette">En préparation</p>
          <h1 id="t-hero">Le guide de {v.nom}</h1>
          <p class="hero__chapo">Il arrive bientôt. Comme à Lyon : une balade à pied, la carte qui te guide, et à chaque arrêt la vidéo qui raconte le lieu.</p>
          <div class="hero__actions">
            <a class="btn btn--plein btn--grand" href={INSTAGRAM} rel="noopener">Être prévenu sur Instagram<Fleche /></a>
            <a class="btn btn--contour btn--grand" href={url("/guides/lyon/")}>En attendant : Lyon</a>
          </div>
          <ul class="hero__points">
            <li>Les vidéos de {v.nom} sortent d'abord sur Instagram</li>
            <li>Le guide ouvre juste après la série</li>
          </ul>
        </div>
        <div class="hero__visuel hero__visuel--seul" aria-hidden="true">
          <img class="hero__carte" src={url(`/cartes/${v.id}.webp`)} alt="" width="600" height="792" fetchpriority="high" />
        </div>
      </div>
    </section>

    <Etapes />

    <Villes titre="Les autres guides" sous="Fais glisser pour les voir." sauf={v.id} />
  </Site>
)}
