---
import Base from "../layouts/Base.astro";
import App from "../app/App.tsx";
import "../app/app.css";
import { MARQUE } from "../marque";
---

<Base
  titre={`Le guide de Lyon : choisis ta balade | ${MARQUE}`}
  description="Choisis une balade dans Lyon ou compose la tienne : une vidéo à chaque étape, la carte, les horaires, les bonnes adresses et ton carnet de voyage."
>
  <App client:only="react">
    <p class="attente" slot="fallback">Chargement du guide de Lyon…</p>
  </App>
  <noscript><p class="attente">Le guide a besoin de JavaScript pour composer ton itinéraire.</p></noscript>
</Base>
