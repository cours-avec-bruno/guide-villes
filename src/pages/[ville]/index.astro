---
// La page d'une ville : la présentation du guide (le « film » : une vidéo de 20 secondes, avec la voix de la série, qui
// montre l'appli et dit ce qu'on y gagne) et l'achat. Une ville dont le guide n'existe pas encore a la même page, sans prix : « bientôt ».
import Anime from "../../components/Anime.astro";
import Logo from "../../components/Logo.astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../base";
import { ADRESSES, ETAPES, NB_VIDEOS } from "../../app/donnees";
import { INSTAGRAM, MARQUE, PRIX_GUIDE } from "../../marque";
import { VILLES, type Ville } from "../../villes";

export function getStaticPaths() {
  return VILLES.map((v) => ({ params: { ville: v.id }, props: { v } }));
}
const { v } = Astro.props as { v: Ville };
const prete = VILLES.find((x) => x.pret)!;
const nE = ETAPES.length, nA = ADRESSES.length;
const lienGratuit = url(`/gratuit/?ville=${v.id}`);
const lienVisite = url(`/${v.id}/visite/`);

// le film de présentation : une vidéo (outils/film-voix.mjs puis outils/film-rendu.mjs), la même pour toutes les villes
const DUREE_FILM = 20;
const TEXTE_FILM = "Avec le guide, plus besoin de réfléchir quand tu visites une ville. Les meilleurs endroits sont déjà rangés en itinéraire. À chaque arrêt, une vidéo te raconte le lieu. Tu sais où bien manger, et quoi voir juste à côté. Tes photos se rangent lieu par lieu. Et sur la carte, tu retraces tout ton voyage.";
const GAINS: [string, string][] = v.pret
  ? [
      [`${nE} lieux, déjà en itinéraire`, "Tu donnes ta durée, le guide trace le chemin et les horaires."],
      ["Une vidéo à chaque arrêt", `${NB_VIDEOS} vidéos racontent ce que tu as sous les yeux.`],
      ["Où manger, juste à côté", `${nA} bonnes adresses, placées sur ton chemin.`],
      ["Ton carnet de voyage", "Tes photos lieu par lieu, et ton trajet à rejouer sur la carte."],
    ]
  : [
      ["Les lieux à voir, déjà en itinéraire", "Tu donnes ta durée, le guide trace le chemin et les horaires."],
      ["Une vidéo à chaque arrêt", "Elle raconte ce que tu as sous les yeux."],
      ["Où manger, juste à côté", "Les bonnes adresses, placées sur ton chemin."],
      ["Ton carnet de voyage", "Tes photos lieu par lieu, et ton trajet à rejouer sur la carte."],
    ];
const donnees = v.pret
  ? {
      "@context": "https://schema.org",
      "@type": "TouristTrip",
      name: `Le guide ${v.de}`,
      description: `Guide de visite ${v.de} à suivre sur son téléphone : ${nE} lieux, ${NB_VIDEOS} vidéos, ${nA} bonnes adresses.`,
      touristType: "Visite à pied",
      inLanguage: "fr",
      itinerary: { "@type": "ItemList", numberOfItems: nE, itemListElement: ETAPES.map((e, i) => ({ "@type": "ListItem", position: i + 1, name: `${e.nom} (${e.lieu}, ${e.quartier})` })) },
    }
  : null;
const Fleche = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>`;
const Coche = `<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"></path></svg>`;
---

<Base
  titre={v.pret ? `Guide ${v.de} : ${nE} lieux secrets à visiter en vidéo | ${MARQUE}` : `Le guide ${v.de} arrive bientôt | ${MARQUE}`}
  description={v.pret
    ? `Visite ${v.nom} avec un guide sur ton téléphone : ${nE} lieux insolites en itinéraire, une vidéo à chaque arrêt, ${nA} bonnes adresses et ton carnet de voyage. Sans appli à installer.`
    : `Le guide de visite interactif ${v.de} se prépare : un itinéraire tout prêt, une vidéo à chaque arrêt, les bonnes adresses et ton carnet de voyage.`}
>
  <Anime slot="tete" />
  {!v.pret && <meta slot="tete" name="robots" content="noindex" />}
  {donnees && <script is:inline slot="tete" type="application/ld+json" set:html={JSON.stringify(donnees)} />}

  <a class="evitement" href="#guide">Aller au guide</a>

  <nav class="nav" aria-label="Navigation principale">
    <Logo href={url("/")} nom={`${MARQUE}, retour à l'accueil`} />
    <a class="nav__retour" href={url("/#villes")}>Toutes les villes</a>
  </nav>

  <main class="ville" data-ville={v.id} data-pret={v.pret ? "" : undefined}>
    <section class="film">
      <picture class:list={["film__fond", { "film__fond--flou": !v.pret }]}>
        {v.pret ? (
          <Fragment>
            <source media="(max-width: 899px)" srcset={url(`/plaques/${v.id}-portrait.webp`)} />
            <img src={url(`/plaques/${v.id}-paysage.webp`)} alt="" decoding="async" />
          </Fragment>
        ) : (
          <img src={url(`/cartes/${v.id}.webp`)} alt="" decoding="async" />
        )}
      </picture>
      <div class="film__voile"></div>

      <div class="film__tete">
        <p class="etiquette">{v.pret ? `Le guide complet · ${v.nom}` : `Bientôt · ${v.nom}`}</p>
        <h1 class="film__titre">Ton guide {v.de}, <span class="g">dans ta poche.</span></h1>
      </div>

      <div class="film__scene">
        <video class="film__video" src={url("/videos/presentation.mp4")} poster={url("/videos/presentation.jpg")} width="720" height="1280" autoplay muted loop playsinline preload="auto" aria-label={`Présentation du guide en ${DUREE_FILM} secondes : ${TEXTE_FILM}`}>
          <track kind="captions" srclang="fr" label="Français" src={url("/videos/presentation.vtt")} />
        </video>
        {!v.pret && <span class="tag film__exemple" style="--c:#fffdf6">Exemple : le guide de {prete.nom}</span>}
      </div>

      <div class="film__bas">
        <button type="button" class="btn btn--plein film__son" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z"></path><path class="film__ondes" d="M15.5 9a4.2 4.2 0 010 6M18 6.5a7.6 7.6 0 010 11"></path></svg>
          <span>Écouter la présentation</span>
        </button>
        <p class="film__duree">Le guide en {DUREE_FILM} secondes.</p>
      </div>
    </section>

    <section class="achat" id="guide">
      <div class="achat__carte sombre">
        {v.pret ? (
          <Fragment>
            <p class="etiquette">Le guide complet</p>
            <h2>{v.nom}, sans réfléchir.</h2>
            <ul class="gains">
              {GAINS.map(([titre, detail]) => <li><Fragment set:html={Coche} /><strong>{titre}</strong><span>{detail}</span></li>)}
            </ul>
            <p class="achat__prix"><span data-assumed>{PRIX_GUIDE}</span><small>une seule fois, sans abonnement</small></p>
            <a class="btn btn--plein btn--bloc" href={lienVisite} data-achat><span>Obtenir le guide {v.de}</span><Fragment set:html={Fleche} /></a>
            <p class="achat__message" role="status" hidden>Le paiement en ligne n'est pas encore ouvert. En attendant, la visite gratuite t'attend juste en dessous.</p>
            <p class="achat__note">Sur ton téléphone, sans appli à installer.</p>
            <a class="achat__gratuit" href={lienGratuit}><span class="zero">0 €</span><span class="achat__gratuit-texte">Visiter gratuitement avec un code</span></a>
          </Fragment>
        ) : (
          <Fragment>
            <p class="etiquette">Bientôt</p>
            <h2>Le guide {v.de} arrive.</h2>
            <ul class="gains">
              {GAINS.map(([titre, detail]) => <li><Fragment set:html={Coche} /><strong>{titre}</strong><span>{detail}</span></li>)}
            </ul>
            <p class="achat__note achat__note--gauche">Il se prépare avec les vidéos de la série. Celui de {prete.nom} est déjà prêt.</p>
            <a class="btn btn--plein btn--bloc" href={url(`/${prete.id}/`)}><span>Voir le guide {prete.de}</span><Fragment set:html={Fleche} /></a>
            <a class="achat__gratuit" href={INSTAGRAM} rel="noopener">Suivre la série sur Instagram</a>
          </Fragment>
        )}
      </div>
    </section>

    {v.pret && (
      <div class="barre-achat">
        <p><span>Le guide {v.de}</span><strong data-assumed>{PRIX_GUIDE}</strong></p>
        <a class="btn btn--plein" href={lienVisite} data-achat><span>Obtenir le guide</span></a>
      </div>
    )}
  </main>

  <script>
    import "../../scripts/ville.ts";
  </script>
</Base>

<style is:global>
  @import "../../styles/accueil.css";
  @import "../../styles/pages.css";
</style>
