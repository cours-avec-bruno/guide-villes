---
// La page d'accueil : ce qu'on vend (un guide de visite en vidéo), les villes, comment ça marche, un vrai arrêt,
// les deux formules du guide de Lyon et les questions. Tout se lit de haut en bas, sans défilement animé.
import Site from "../layouts/Site.astro";
import Villes from "../components/Villes.astro";
import Etapes from "../components/Etapes.astro";
import Exemple from "../components/Exemple.astro";
import Formules from "../components/Formules.astro";
import Faq from "../components/Faq.astro";
import Fleche from "../components/Fleche.astro";
import Telephone from "../components/Telephone.astro";
import { url } from "../base";
import { MARQUE, PREUVE, PRIX_COMPLET, PRIX_COMPLET_NOMBRE } from "../marque";
import { ADRESSES, ETAPES, NB_VIDEOS } from "../app/donnees";
import { FAQ } from "../data/faq";

const nE = ETAPES.length, nA = ADRESSES.length;
const donnees = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      name: "Le guide de Lyon",
      description: `Guide de visite de Lyon à suivre sur son téléphone : ${nE} lieux, ${NB_VIDEOS} vidéos, ${nA} bonnes adresses.`,
      brand: { "@type": "Brand", name: MARQUE },
      offers: [
        { "@type": "Offer", name: "Guide gratuit : Les 5 secrets de Lyon", price: "0", priceCurrency: "EUR" },
        { "@type": "Offer", name: "Guide complet de Lyon", price: PRIX_COMPLET_NOMBRE, priceCurrency: "EUR" },
      ],
    },
    { "@type": "FAQPage", mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.r } })) },
  ],
};
---

<Site
  titre={`${MARQUE} : les guides de visite en vidéo, à suivre sur ton téléphone`}
  description={`Va voir en vrai les lieux des vidéos « Ce que tu ne sais pas sur… ». Le guide de Lyon : ${nE} lieux, une vidéo à chaque arrêt, la carte qui te guide. Gratuit avec un code, ou ${PRIX_COMPLET} le guide complet.`}
  ici={["villes", "comment", "formules", "questions"]}
>
  <script is:inline slot="tete" type="application/ld+json" set:html={JSON.stringify(donnees)} />

  <section class="hero" aria-labelledby="t-hero">
    <div class="enveloppe hero__grille">
      <div class="hero__texte">
        <p class="etiquette">Des guides de visite en vidéo</p>
        <h1 id="t-hero"><span class="g">Tu as vu la vidéo&#8239;?</span> <span>Va voir en vrai.</span></h1>
        <p class="hero__chapo">Le guide sur ton téléphone te mène de lieu en lieu. Sur place, tu lances la vidéo qui raconte ce que tu as sous les yeux.</p>
        <div class="hero__actions">
          <a class="btn btn--plein btn--grand" href="#formules">Commencer gratuitement<Fleche sens="bas" /></a>
          <a class="btn btn--contour btn--grand" href={url("/lyon/")}>J'ai un code</a>
        </div>
        <ul class="hero__points">
          <li>Gratuit avec un code, ou {PRIX_COMPLET} le guide complet</li>
          <li>Sans appli à installer, sans compte</li>
          <li>Par la série « Ce que tu ne sais pas sur… », {PREUVE}</li>
        </ul>
      </div>
      <div class="hero__visuel" aria-hidden="true">
        <img class="hero__carte" src={url("/cartes/lyon.webp")} alt="" width="600" height="792" fetchpriority="high" />
        <Telephone ecran="video" alt="" class="hero__tel" eager />
        <p class="hero__bulle"><strong>{nE} lieux</strong> à Lyon</p>
      </div>
    </div>
  </section>

  <Villes id="villes" titre="Choisis ta ville" sous="Le guide de Lyon est prêt. Fais glisser pour voir les villes qui arrivent." />

  <Etapes />

  <Exemple />

  <Formules />

  <Faq />

  <section class="fin sombre" aria-labelledby="t-fin">
    <div class="enveloppe">
      <h2 id="t-fin" class="titre-section entre">{nE} lieux t'attendent <span class="g">à Lyon.</span></h2>
      <div class="fin__actions entre">
        <a class="btn btn--jaune btn--grand" href="#formules">Commencer gratuitement<Fleche sens="bas" /></a>
        <a class="btn btn--contour btn--grand" href={url("/guides/lyon/")}>Voir le guide de Lyon</a>
      </div>
    </div>
  </section>
</Site>
