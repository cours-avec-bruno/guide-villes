---
// La page de vente. Sa chorégraphie au défilement reprend, à la demande de Bruno, celle du brief « Tides in Motion » :
// titre qui s'assemble à partir de pictos en pixels, éventail de cartes → dispersion → pile → roue, panneau qui grandit
// depuis le centre avec un objet qui flotte puis dans lequel on plonge, enfin une ligne de texte qui défile de côté.
// Tout est adapté au guide : les cartes sont les villes, l'objet est le téléphone avec l'appli, la ligne dit ce qu'on y fait.
// Sans JavaScript ou avec « réduire les animations », la page se lit comme une page normale (classe « anime » absente).
import Base from "../layouts/Base.astro";
import { url } from "../base";
import { ACTION, MARQUE, PRIX_SUR_MESURE } from "../marque";
import { ADRESSES, ETAPES, NB_VIDEOS } from "../app/donnees";

const VILLES = [
  { id: "bordeaux", nom: "Bordeaux" },
  { id: "nice", nom: "Nice" },
  { id: "lyon", nom: "Lyon", pret: true },
  { id: "paris", nom: "Paris" },
  { id: "marseille", nom: "Marseille" },
  { id: "toulouse", nom: "Toulouse" },
  { id: "nantes", nom: "Nantes" },
  { id: "rennes", nom: "Rennes" },
  { id: "lille", nom: "Lille" },
  { id: "grenoble", nom: "Grenoble" },
  { id: "montpellier", nom: "Montpellier" },
];
const TITRE = "Lyon à ta façon";
const nE = ETAPES.length, nA = ADRESSES.length;
const lienAppli = url("/lyon/?nouveau");
---

<Base
  titre={`${MARQUE} : le guide de Lyon sur mesure, étape par étape`}
  description={`Compose ta visite de Lyon selon ton temps : ${nE} étapes racontées en vidéo, les horaires, ${nA} bonnes adresses et un carnet de voyage avec tes photos.`}
>
  <script is:inline slot="tete">
    // Le défilement animé est la version par défaut de la page d'accueil, même quand l'appareil demande de réduire
    // les animations (choix du projet). « ?simple » affiche la page sans animation et retient ce choix ; « ?anime » y revient.
    (function () {
      var q = location.search, simple = /[?&]simple\b/.test(q);
      try {
        if (simple) localStorage.setItem("accueil", "simple");
        else if (/[?&]anime\b/.test(q)) localStorage.removeItem("accueil");
        else simple = localStorage.getItem("accueil") === "simple";
      } catch (e) {}
      document.documentElement.classList.add(simple ? "simple" : "anime");
    })();
  </script>

  <a class="evitement" href="#offres">Aller aux offres</a>

  <nav class="nav" aria-label="Navigation principale">
    <a class="nav__logo" href="#haut" aria-label={`${MARQUE}, haut de la page`}>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 45S8 30.8 8 19a16 16 0 1132 0c0 11.800-16 26-16 26z" fill="currentColor"></path>
        <path d="M16.500 19a7.500 7.500 0 0115 0v5.500h-4.800V19a2.700 2.700 0 00-5.400 0v9.500" fill="none" stroke="var(--nav-creux)" stroke-width="3.200" stroke-linecap="round"></path>
      </svg>
      <span>{MARQUE}</span>
    </a>
    <div class="nav__liens">
      <a href="#villes" data-saut="0.2">Villes</a>
      <a href="#appli" data-saut="0.74">Appli</a>
      <a href="#offres">Offres</a>
    </div>
    <a class="btn btn--plein nav__btn" href={lienAppli}>
      {ACTION}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
    </a>
  </nav>

  <main id="haut">
    <section class="histoire" id="histoire">
      <header class="hero">
        <h1 class="hero__titre" aria-label={`${TITRE} : le guide de visite sur mesure`}>
          <span class="hero__mot" aria-hidden="true">{TITRE.split("").map((c) => <span class="l">{c}</span>)}</span>
          <span class="hero__pictos" aria-hidden="true"></span>
        </h1>
        <div class="avion" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <path d="M3 30L61 5 43 59 30 38z" fill="#fffdf6"></path>
            <path d="M61 5L30 38l-5 15z" fill="#dccfb2"></path>
            <path d="M61 5L3 30l22 8z" fill="#fffdf6" stroke="#16202a" stroke-width="2" stroke-linejoin="round"></path>
            <path d="M3 30L61 5 43 59 30 38l-5 15-0.200-15z" fill="none" stroke="#16202a" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="hero__sous">
          <p>Le guide de visite qui s'adapte à ton temps : {nE} étapes racontées en vidéo, {nA} bonnes adresses.</p>
          <a class="btn btn--plein" href={lienAppli}>
            {ACTION}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
        </div>
        <p class="bascule">
          <a class="bascule__simple" href="?simple">Version sans animation</a>
          <a class="bascule__anime" href="?anime">Voir la version animée</a>
        </p>
      </header>

      <div class="scene">
        <div class="processus" id="villes">
          <h2>
            <span class="ligne">
              <span class="m g">De</span> <span class="m">la</span> <span class="m">vidéo</span>
              <span class="m vignette" aria-hidden="true" style={`background-image:url(${url("/cartes/lyon.webp")})`}></span>
              <span class="m g">à</span> <span class="m">la</span> <span class="m">rue,</span>
            </span>
            <span class="ligne">
              <span class="m">une</span> <span class="m">ville</span> <span class="m g">après</span> <span class="m">l'autre</span>
            </span>
          </h2>
          <p class="processus__sous">Le guide de Lyon est prêt. Dix autres villes arrivent.</p>
          <a class="btn btn--plein processus__btn" href="#offres">
            Voir les offres
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
        </div>

        <ul class="cartes" aria-label="Les guides de villes">
          {VILLES.map((v, i) => (
            <li class="carte-v" data-pret={v.pret ? "" : undefined}>
              <img src={url(`/cartes/${v.id}.webp`)} alt="" width="600" height="792" loading="eager" fetchpriority={i < 6 ? "high" : "low"} decoding="async" />
              <span class="carte-v__nom">{v.nom}</span>
              <span class="carte-v__etat">{v.pret ? "Disponible" : "Bientôt"}</span>
            </li>
          ))}
          <li class="carte-v carte-v--question">
            <span class="carte-v__point" aria-hidden="true">?</span>
            <span class="carte-v__nom">Ta ville</span>
            <span class="carte-v__etat">À toi de voter</span>
          </li>
        </ul>

        <div class="panneau" id="appli">
          <picture class="panneau__fond">
            <source media="(max-width: 819px)" srcset={url("/plaques/lyon-portrait.webp")} />
            <img src={url("/plaques/lyon-paysage.webp")} alt="" loading="lazy" decoding="async" />
          </picture>
          <div class="panneau__voile"></div>
          <p class="mots mots--hg"><span class="m g">Pas</span> <span class="m g">juste</span> <span class="m">des</span> <span class="m">vidéos.</span></p>
          <div class="tel">
            <img src={url("/plaques/appli.webp")} alt="L'appli ouverte sur un parcours dans Lyon : les étapes, leurs horaires et les trajets à pied." width="780" height="1688" loading="lazy" decoding="async" />
          </div>
          <p class="mots mots--bd"><span class="m g">Un</span> <span class="m">guide</span> <span class="m g">qui</span> <span class="m">marche</span> <span class="m">avec</span> <span class="m">toi.</span></p>
        </div>
        <div class="noir"></div>
      </div>
    </section>

    <section class="manifeste sombre" id="manifeste" aria-label="Ce que fait le guide">
      <div class="manifeste__scene">
        <div class="piste">
          <div class="bloc intro">
            <p><span class="mot g">Ton</span> <span class="mot g">voyage,</span> <span class="mot">du</span> <span class="mot">premier</span> <span class="mot">pas</span></p>
            <p><span class="mot">au</span> <span class="mot">carnet</span> <span class="mot g">de</span> <span class="mot g">souvenirs.</span></p>
            <span class="tag auto" style="--r:-6deg;--c:#f5bd2f;top:calc(var(--mfs) * -0.52);left:0">{nE} étapes</span>
            <span class="tag auto" style="--r:-4deg;--c:#dccfb2;top:calc(var(--mfs) * -0.6);left:calc(var(--mfs) * 2.1)">{NB_VIDEOS} vidéos</span>
            <span class="tag auto" style="--r:4deg;--c:#a9cfe2;bottom:calc(var(--mfs) * -0.5);left:calc(var(--mfs) * 0.4)">{nA} adresses</span>
          </div>

          <span class="objet auto" style="--r:-12deg;--t:1.150em" aria-hidden="true">
            <svg viewBox="0 0 60 78"><path d="M30 76S4 50 4 29a26 26 0 1152 0c0 21-26 47-26 47z" fill="#de3341" stroke="#fffdf6" stroke-width="4"></path><circle cx="30" cy="29" r="10" fill="#fffdf6"></circle></svg>
          </span>

          <span class="mot g">Tu</span><span class="mot g">choisis</span>
          <span class="pile">
            <span class="tag tag--grand auto" style="--r:-8deg;--c:#f5bd2f">1 h 30</span>
            <span class="tag auto" style="--r:6deg;--c:#a9cfe2">ou la journée</span>
          </span>
          <span class="mot">ton</span><span class="mot">temps,</span><span class="mot g">tes</span><span class="mot g">envies.</span>

          <span class="objet auto" style="--r:8deg;--t:.340em" aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M10 0c.800 5.600 3.600 8.600 10 10-6.400 1.400-9.200 4.400-10 10-.800-5.600-3.600-8.600-10-10 6.400-1.400 9.200-4.400 10-10z" fill="#f5e7c4"></path></svg>
          </span>
          <span class="objet auto" style="--r:9deg;--t:1em" aria-hidden="true">
            <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="35" fill="#fffdf6" stroke="#16202a" stroke-width="5"></circle><path d="M40 18v23l14 9" fill="none" stroke="#de3341" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="40" cy="40" r="4" fill="#16202a"></circle></svg>
          </span>

          <span class="mot">Le</span><span class="mot">parcours</span><span class="mot g">se</span><span class="mot g">compose,</span>
          <span class="tag tag--grand auto" style="--r:-8deg;--c:#dccfb2">horaires</span>
          <span class="tag tag--grand auto" style="--r:3deg;--c:#f5bd2f">pause repas</span>
          <span class="mot g">tu</span><span class="mot">coches</span><span class="mot">chaque</span><span class="mot">étape.</span>

          <span class="objet auto" style="--r:-9deg;--t:1.700em" aria-hidden="true">
            <svg viewBox="0 0 150 70"><rect x="4" y="4" width="142" height="62" rx="8" fill="none" stroke="#f0606c" stroke-width="6"></rect><rect x="13" y="13" width="124" height="44" rx="4" fill="none" stroke="#f0606c" stroke-width="2"></rect><text x="75" y="48" text-anchor="middle" font-family="Bebas Neue, Impact, sans-serif" font-size="38" letter-spacing="3" fill="#f0606c">VISITÉ</text></svg>
          </span>

          <span class="mot g">Sur</span><span class="mot g">le</span><span class="mot g">chemin,</span><span class="mot">les</span><span class="mot">bonnes</span><span class="mot">adresses.</span>
          <span class="objet auto" style="--r:10deg;--t:1.100em" aria-hidden="true">
            <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="35" fill="#f5bd2f" stroke="#fffdf6" stroke-width="5"></circle><path d="M30 20v15a5 5 0 005 5v22M26 20v11M34 20v11M52 20c-4 2-7 8-7 16 0 3 2 4 7 4v22" fill="none" stroke="#16202a" stroke-width="4.500" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          <span class="tag tag--grand auto" style="--r:-10deg;--c:#a9cfe2">bouchons</span>

          <span class="mot g">Et</span><span class="mot g">à</span><span class="mot g">la</span><span class="mot g">fin,</span><span class="mot">ton</span><span class="mot">trajet</span><span class="mot g">et</span><span class="mot">tes</span><span class="mot">photos</span>
          <span class="objet polaroid auto" style="--r:7deg;--t:1.250em" aria-hidden="true"><img src={url("/cartes/lyon.webp")} alt="" loading="lazy" decoding="async" /></span>
          <span class="mot g">sur</span><span class="mot g">la</span><span class="mot">carte.</span>
          <span class="piste__fin"></span>
        </div>
      </div>
    </section>

    <section class="offres" id="offres">
      <div class="enveloppe">
        <h2>Deux façons de visiter Lyon</h2>
        <div class="offres__grille">
          <article class="offre">
            <h3>Les 5 secrets</h3>
            <p class="offre__prix">Gratuit</p>
            <div class="offre__vignettes" aria-hidden="true">
              {["perrache", "celestins", "guignol", "traboules", "fontaine"].map((id) => <img src={url(`/videos/lyon/${id}.jpg`)} alt="" width="46" height="60" loading="lazy" decoding="async" />)}
            </div>
            <ul>
              <li>5 étapes, de Perrache aux Terreaux</li>
              <li>Une vidéo à chaque étape</li>
              <li>La carte et les horaires</li>
            </ul>
            <a class="btn btn--contour btn--bloc" href={url("/lyon/?visite=5-secrets")}>Commencer les 5 secrets</a>
          </article>
          <article class="offre offre--forte sombre">
            <p class="etiquette offre__tag">Le guide complet</p>
            <h3>Lyon sur mesure</h3>
            <p class="offre__prix" data-assumed>{PRIX_SUR_MESURE}</p>
            <div class="offre__vignettes" aria-hidden="true">
              {ETAPES.slice(0, 6).map((e) => <img src={url(`/videos/lyon/${e.videos[e.videos.length - 1]}.jpg`)} alt="" width="46" height="60" loading="lazy" decoding="async" />)}
              <span class="offre__plus">+{nE - 6}</span>
            </div>
            <ul>
              <li>Un parcours selon ton temps et tes envies</li>
              <li>{nE} étapes et {NB_VIDEOS} vidéos</li>
              <li>{nA} bonnes adresses sur le chemin</li>
              <li>Ton carnet de voyage, avec tes photos</li>
            </ul>
            <a class="btn btn--plein btn--bloc" href={lienAppli}>
              {ACTION}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            </a>
          </article>
        </div>
        <p class="offres__suite">Bordeaux, Nice, Paris, Marseille, Toulouse, Nantes, Rennes, Lille, Grenoble et Montpellier arrivent.</p>
      </div>
    </section>
  </main>

  <footer class="pied">
    <div class="enveloppe">
      <p class="pied__marque">{MARQUE}</p>
      <p>© {new Date().getFullYear()} {MARQUE}. Fond de carte et trajets : IGN, Géoplateforme. Lieux : contributeurs OpenStreetMap.</p>
    </div>
  </footer>

  <script>
    import "../scripts/accueil.ts";
  </script>
</Base>

<style is:global>
  @import "../styles/accueil.css";
</style>
